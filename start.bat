@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ============================================
echo   第一次启动需要先安装,大概几分钟,请耐心等待
echo   屏幕刷一堆字是正常的,不要关窗口
echo ============================================
echo.
call npm install
echo.
echo ============================================
echo   安装完成,正在启动...
echo   稍等片刻会出现一个二维码
echo   用 iPhone 自带「相机」对准二维码即可
echo ============================================
echo.
call npx expo start
echo.
echo （如果上面报错了,把这个窗口截图发给助手）
pause
